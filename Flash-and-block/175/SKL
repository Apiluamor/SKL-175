local function tween(obj, t, props, style, dir)
    local ti = TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, ti, props)
    tw:Play()
    return tw
end

local function playMusic()
    local sound = Instance.new("Sound")
    sound.Name = "175_EditMusic"
    sound.Volume = 0
    sound.Looped = true
    sound.Parent = SoundService
    local ok = false
    pcall(function()
        if getcustomasset and writefile then
            local req = (syn and syn.request) or (http and http.request) or http_request or request
            if req then
                local res = req({ Url = MUSIC_URL, Method = "GET" })
                local body = res and (res.Body or res.body)
                if body and #tostring(body) > 1000 then
                    writefile("175_edit_music.mp3", body)
                    sound.SoundId = getcustomasset("175_edit_music.mp3")
                    ok = true
                end
            end
        end
    end)
    if not ok then pcall(function() sound.SoundId = MUSIC_URL end) end
    pcall(function() sound:Play() end)
    tween(sound, 2.5, { Volume = 0.85 })
    return sound
end

