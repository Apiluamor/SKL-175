local function playMusic()
    local sound = Instance.new("Sound")
    sound.Name = "175_IntroMusic"
    sound.Volume = 0.7
    sound.Looped = true
    sound.Parent = SoundService
    local ok = false
    pcall(function()
        if getcustomasset and writefile and request then
            local res = request({ Url = MUSIC_URL, Method = "GET" })
            local body = res and (res.Body or res.body)
            if body and #tostring(body) > 1000 then
                writefile("175_intro_music.mp3", body)
                sound.SoundId = getcustomasset("175_intro_music.mp3")
                ok = true
            end
        end
    end)
    if not ok then
        pcall(function()
            sound.SoundId = MUSIC_URL
        end)
    end
    pcall(function() sound:Play() end)
    return sound
end

