-- copiar discord al tocar
local function copyDiscord()
    local copied = false
    pcall(function()
        if setclipboard then
            setclipboard(DISCORD)
            copied = true
        elseif toclipboard then
            toclipboard(DISCORD)
            copied = true
        end
    end)
    discLabel.Text = copied and "COPIED!  ·  ¡COPIADO!" or DISCORD
    discBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 100)
    task.delay(1.4, function()
        if discLabel and discLabel.Parent then
            discLabel.Text = "discord.gg/WWDM76W3dc"
            discBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
        end
    end)
end

