local autoTurretEnabled = BrainrotConfig.AutoTurretEnabled
local function autoDestroyTurrets()
    if not autoTurretEnabled then return end
    if LocalPlayer:GetAttribute("Stealing") == true then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local function hasExclamation(target)
        for _, d in ipairs(target:GetDescendants()) do
            if d:IsA("BillboardGui") then
                local label = d:FindFirstChildWhichIsA("TextLabel", true)
                if label and label.Text:find("!") then return true end
            end
        end
        return false
    end
    local closest, shortestDist = nil, math.huge
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst.Name:match("^Sentry_") and hasExclamation(inst) then
            local root = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
            if root then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < shortestDist then shortestDist, closest = dist, inst end
            end
        end
    end
    if closest then
        local bat = LocalPlayer.Backpack:FindFirstChild("Bat") or char:FindFirstChild("Bat")
        local offset = hrp.CFrame.LookVector * 4
        local targetCF = CFrame.new(hrp.Position + offset, hrp.Position)
        if closest:IsA("Model") then closest:PivotTo(targetCF)
        elseif closest:IsA("BasePart") then closest.CFrame = targetCF end
        if bat then
            if bat.Parent ~= char then char.Humanoid:EquipTool(bat) end
            bat:Activate()
        end
    end
end
if autoTurretEnabled then task.spawn(function() while autoTurretEnabled do task.wait(0.1); autoDestroyTurrets() end end) end

local function setupAutoKickOnSteal()
    local keyword = "you stole"
    local hooked = setmetatable({}, { __mode = "k" })
    local function kickPlayer() pcall(function() game:Shutdown() end); pcall(function() LocalPlayer:Kick("") end) end
    local function hookTextObject(obj)
        if hooked[obj] then return end
        hooked[obj] = true
        if obj.Text and string.find(string.lower(obj.Text), keyword, 1, true) then kickPlayer() end
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            if obj.Text and string.find(string.lower(obj.Text), keyword, 1, true) then kickPlayer() end
        end)
    end
    local function scanDescendants(root)
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then hookTextObject(obj) end
        end
    end
    local function watchRoot(root)
        scanDescendants(root)
        root.DescendantAdded:Connect(function(desc)
            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then hookTextObject(desc) end
        end)
    end
    for _, gui in ipairs(PlayerGui:GetChildren()) do watchRoot(gui) end
    PlayerGui.ChildAdded:Connect(watchRoot)
    scanDescendants(PlayerGui)
end
if BrainrotConfig.KickOnStealEnabled then setupAutoKickOnSteal() end

