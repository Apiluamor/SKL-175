local function ACBypass()
    local function checkAndBlock(remote, args)
        for _, v in pairs(args) do
            if type(v) == "string" and string.find(string.lower(v), "stop") then return true end
        end
        return false
    end
    local ok = pcall(function()
        local oldRemote
        oldRemote = hookfunction(Instance.new('RemoteEvent').FireServer, newcclosure(function(self, ...)
            local args = {...}
            if checkAndBlock(self, args) then return nil end
            return oldRemote(self, ...)
        end))
    end)
    if not ok then cloneref(game.Players).LocalPlayer:Kick("not supported executor!") end
end
