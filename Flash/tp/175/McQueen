-- ==================== SPEED SYSTEM (EDITABLE) ====================
local SPEED = 28
local speedConnection = nil
local speedEnabled = Config.speedEnabled

local function getCharSpeed()
    local c = player.Character or player.CharacterAdded:Wait()
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildWhichIsA("Humanoid")
    return c, hrp, hum
end

local function getMoveDirSpeed()
    local _, _, hum = getCharSpeed()
    if not hum then return Vector3.zero end
    local move = hum.MoveDirection
    return move.Magnitude > 0.1 and move.Unit or Vector3.zero
end

local function startSpeed()
    if speedConnection then return end
    speedConnection = RunService.Heartbeat:Connect(function()
        if not speedEnabled then return end
        local _, hrp, hum = getCharSpeed()
        if not hrp or not hum then return end
        local dir = getMoveDirSpeed()
        if dir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                dir.X * SPEED,
                hrp.AssemblyLinearVelocity.Y,
                dir.Z * SPEED
            )
        end
    end)
end

local function stopSpeed()
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
end

local function toggleSpeed()
    speedEnabled = not speedEnabled
    Config.speedEnabled = speedEnabled
    saveConfig()
    
    if speedEnabled then
        startSpeed()
        if speedButtonLabel then
            speedButtonLabel.Text = "SPEED: ON"
        end
        TweenService:Create(speedButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 0)}):Play()
    else
        stopSpeed()
        if speedButtonLabel then
            speedButtonLabel.Text = "SPEED: OFF"
        end
        TweenService:Create(speedButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(120, 0, 0)}):Play()
    end
end

